<!-- page to show a particular Campground -->
<% layout("layouts/boilerplate.ejs") %>

<div class="row">
  <div class="col-6">
    <div class="card mb-3">
      <div class="ratio ratio-16x9">
        <img src="<%= campground.image %>" class="card-img-top" alt="..." />
      </div>
      <div class="card-body">
        <h5 class="card-title"><%= campground.title %></h5>
        <p class="card-text"><%= campground.description %></p>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item text-secondary">
          <%= campground.location %>
        </li>
        <li class="list-group-item">$ <%= campground.price %>/night</li>
      </ul>
      <div class="card-body">
        <a
          href="/campgrounds/<%= campground._id %>/edit"
          class="card-link btn btn-info bg-gradient"
          >Edit</a
        >
        <form
          class="d-inline"
          action="/campgrounds/<%= campground._id %>?_method=DELETE"
          method="POST"
        >
          <button class="btn btn-danger bg-gradient">Delete</button>
        </form>
      </div>
      <div class="card-footer">
        <a href="/campgrounds">All Campgrounds</a>
      </div>
    </div>
  </div>
  <div class="col-6">
    <div class="card mb-3" style="width: 30rem">
      <h4 class="card-body">Leave a Review</h4>
    <form action="/campgrounds/<%= campground._id %>/reviews" method="POST"  class=" validated-form mb-3" novalidate   >
    <div class="mb-3 card-body" style="width: 30rem">
      <label class="form-label "for="rating">Rating</label>
      <input class="form-range" type="range" min="0" max="5" name="review[rating]" id="rating">
    </div>
    <div class="mb-3 card-body" style="width: 30rem">
      <label class="form-label " for="body">Review</label>
      <textarea class="form-control" name="review[body]" id="body" cols="3" rows="3" required></textarea>
      <div class="valid-feedback">
                Looks good!
      </div>
    </div>
    <div class="card-body">
      <button class="btn btn-success">Submit</button>
    </div>
  </form> 
  <%for(let review of campground.reviews){%>
  <div class="card-body">
    <h5 class="card-title">Rating: <%= review.rating %></h5>
    <p class="card-text">Review: <%= review.body %></p>
    <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
      <button class="btn btn-danger btn-sm">Delete</button>
    </form>
  </div>
  <%}%>
    </div>
  </div>
</div>

